$font-size: 14pt;
$font-name: Rubik;
$bg0: #161616;
$bg1: #161616;
$bg2: #282828;
$bg3: #282828;
$fg0: #f6f6f6;
$fg1: #f6f6f6;
$fg2: #cfcfcf;
$accent: #8999a9;
$accent-light: lighten(#8999a9, 10%);
$blue: #3584e4;
$blue-light: lighten(#3584e4, 10%);
$cyan: #2190a4;
$cyan-light: lighten(#2190a4, 10%);
$green: #3a944a;
$green-light: lighten(#3a944a, 10%);
$yellow: #c88800;
$yellow-light: lighten(#c88800, 10%);
$orange: #ed5b00;
$orange-light: lighten(#ed5b00, 10%);
$red: #e62d42;
$red-light: lighten(#e62d42, 10%);
$purple: #9141ac;
$purple-light: lighten(#9141ac, 10%);
$widget-radius: 8px;
$window-padding: 15px;
$window-radius: 23px;
$window-opacity: 1;
$window-border-width: 0px;
$window-border-color: $bg2;
$window-outline-width: 0px;
$window-outline-color: $fg1;
$window-shadow-offset: 0px 0px;
$window-shadow-blur: 10px;
$window-shadow-spread: 0px;
$window-shadow-color: black;
$window-shadow-opacity: 0.4;
$bar-position: top;
$bar-bg: $bg0;
$bar-opacity: 1;
$bar-margin: 0px 0px 0px 0px;
$bar-margin-top: 0px;
$bar-margin-right: 0px;
$bar-margin-bottom: 0px;
$bar-margin-left: 0px;
$bar-padding: 6px;
$bar-border-width: 0px;
$bar-border-color: $bg2;
$bar-separator-width: 2px;
$bar-separator-color: $bg2;
$bar-button-bg: $bg0;
$bar-button-bg-hover: $bg1;
$bar-button-bg-active: $bg2;
$bar-button-fg: $fg0;
$bar-button-border-width: 0px;
$bar-button-border-color: $bg2;
$bar-button-opacity: 1;
$bar-button-padding: 0px 8px;
$bar-shadow-offset: 0px 0px;
$bar-shadow-blur: 10px;
$bar-shadow-spread: 0px;
$bar-shadow-color: black;
$bar-shadow-opacity: 0.4;
$bar-vertical: false;
$bar-size: 48px;
$transition: 0.2s;
$shadow: true;